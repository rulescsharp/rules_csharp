load("@stardoc//stardoc:stardoc.bzl", "stardoc")

package(default_visibility = ["//visibility:public"])

# defs.md is checked in so GitHub can render it. //tests/analysis:docs_test fails when it
# drifts from the generated copy.
exports_files(["defs.md"])

stardoc(
    name = "defs_doc",
    out = "defs_doc.md",
    input = "//csharp:defs.bzl",
    deps = ["//csharp:defs_bzl"],
)

stardoc(
    name = "toolchains_doc",
    out = "toolchains_doc.md",
    input = "//csharp:toolchains.bzl",
    deps = ["//csharp:toolchains_bzl"],
)

stardoc(
    name = "extensions_doc",
    out = "extensions_doc.md",
    input = "//csharp:extensions.bzl",
    deps = ["//csharp:extensions_bzl"],
)

# The proto stubs stay out of the reference. The module docstring already points to
# rules_csharp_proto, and Bazel 7 renders their **kwargs differently from Bazel 8 and 9.
stardoc(
    name = "docs",
    out = "defs_generated.md",
    input = "//csharp:defs.bzl",
    symbol_names = [
        "CSharpAnalyzerInfo",
        "CSharpInfo",
        "CSharpToolchainInfo",
        "csharp_analyzer_import",
        "csharp_analyzer_library",
        "csharp_binary",
        "csharp_import",
        "csharp_library",
        "csharp_test",
    ],
    deps = ["//csharp:defs_bzl"],
)
