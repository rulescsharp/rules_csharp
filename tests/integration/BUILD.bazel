load("//csharp:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")
load(":linux_cross_transition.bzl", "linux_binary_collector")

package(default_visibility = ["//visibility:public"])

csharp_library(
    name = "lib",
    srcs = ["Lib.cs"],
)

csharp_binary(
    name = "app",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

csharp_test(
    name = "smoke_test",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

csharp_test(
    name = "source_generator_test",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

# Reference assemblies stay identical when only method bodies change.
csharp_test(
    name = "abi_determinism_test",
    srcs = ["AbiDeterminismTest.cs"],
    data = [
        "//tests/integration/abi_var1:lib",
        "//tests/integration/abi_var2:lib",
    ],
    deps = ["//tests/support:runfiles"],
)

csharp_test(
    name = "reproducible_paths_test",
    srcs = ["ReproduciblePathsTest.cs"],
    data = [":lib"],
    deps = ["//tests/support:runfiles"],
)

# A binary cross-compiled for Linux ARM64 is an ELF apphost.
linux_binary_collector(
    name = "linux_arm64_app",
    binary = ":app",
)

csharp_test(
    name = "linux_elf_test",
    srcs = ["LinuxElfTest.cs"],
    data = [":linux_arm64_app"],
    deps = ["//tests/support:runfiles"],
)

# The sync tool writes a .csproj from a BUILD file, a second sync changes
# nothing, and --check fails once a new source is added.
csharp_test(
    name = "sync_roundtrip_test",
    srcs = ["SyncRoundtripTest.cs"],
    data = ["//csharp:sync"],
    deps = ["//tests/support:runfiles"],
)

# A Microsoft.NET.Sdk.Web app compiles and starts.
csharp_test(
    name = "web_test",
    srcs = ["WebTest.cs"],
    sdk = "Microsoft.NET.Sdk.Web",
)

# A plain binary runs against the ASP.NET Core shared framework a Web library uses.
csharp_library(
    name = "web_lib",
    srcs = ["WebLib.cs"],
    sdk = "Microsoft.NET.Sdk.Web",
)

csharp_test(
    name = "framework_reference_test",
    srcs = ["FrameworkReferenceTest.cs"],
    deps = [":web_lib"],
)

# The Worker SDK's implicit usings compile against the hosting assemblies in ASP.NET Core.
csharp_test(
    name = "worker_test",
    srcs = ["WorkerTest.cs"],
    framework_references = ["Microsoft.AspNetCore.App"],
    sdk = "Microsoft.NET.Sdk.Worker",
)

csharp_library(
    name = "renamed_lib",
    srcs = ["Lib.cs"],
    output_assembly = "Contoso.Renamed",
)

csharp_test(
    name = "output_assembly_test",
    srcs = ["OutputAssemblyTest.cs"],
    output_assembly = "Contoso.Renamed.Tests",
    deps = [":renamed_lib"],
)

# System.IO.Ports only works from its runtimes/unix and runtimes/win files.
csharp_test(
    name = "rid_fallback_test",
    srcs = ["RidFallbackTest.cs"],
    deps = ["@nuget//:System.IO.Ports"],
)

csharp_library(
    name = "doc_lib",
    srcs = ["DocLib.cs"],
    generate_documentation_file = True,
)

csharp_test(
    name = "xml_doc_test",
    srcs = ["XmlDocTest.cs"],
    data = [":doc_lib"],
    deps = ["//tests/support:runfiles"],
)

# Run with -c opt too, where the assembly is optimized and DEBUG is undefined.
csharp_test(
    name = "compilation_mode_test",
    srcs = ["CompilationModeTest.cs"],
    allow_unsafe_blocks = True,
)

# A real MSTest suite run through vstest, with the adapter from the MSTest.TestAdapter package.
csharp_test(
    name = "mstest_suite",
    srcs = ["MSTestSuite.cs"],
    target_type = "library",
    test_filter = "TestCategory=Unit",
    deps = [
        "@nuget//:MSTest.TestAdapter",
        "@nuget//:MSTest.TestFramework",
        "@nuget//:Microsoft.NET.Test.Sdk",
    ],
)

# Four shards for three tests, so one shard runs nothing and still passes.
csharp_test(
    name = "mstest_sharded",
    srcs = ["MSTestSuite.cs"],
    shard_count = 4,
    target_type = "library",
    test_filter = "TestCategory=Unit",
    deps = [
        "@nuget//:MSTest.TestAdapter",
        "@nuget//:MSTest.TestFramework",
        "@nuget//:Microsoft.NET.Test.Sdk",
    ],
)

# A real xUnit suite, with the adapter from xunit.runner.visualstudio, split over two shards.
csharp_test(
    name = "xunit_sharded",
    srcs = ["XunitSuite.cs"],
    shard_count = 2,
    target_type = "library",
    test_filter = "Category=Unit",
    deps = [
        "@nuget//:Microsoft.NET.Test.Sdk",
        "@nuget//:xunit",
        "@nuget//:xunit.runner.visualstudio",
    ],
)
