load("//csharp:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")
load(":linux_cross_transition.bzl", "linux_binary_collector")

package(default_visibility = ["//visibility:public"])

csharp_library(
    name = "lib",
    srcs = ["Lib.cs"],
)

csharp_binary(
    name = "app",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

csharp_test(
    name = "smoke_test",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

csharp_test(
    name = "source_generator_test",
    srcs = ["App.cs"],
    deps = [
        ":lib",
        "@nuget//:CommandLineParser",
        "@nuget//:Riok.Mapperly",
    ],
)

# Reference assemblies stay identical when only method bodies change.
csharp_test(
    name = "abi_determinism_test",
    srcs = ["AbiDeterminismTest.cs"],
    data = [
        "//tests/integration/abi_var1:lib",
        "//tests/integration/abi_var2:lib",
    ],
    deps = ["//tests/support:runfiles"],
)

csharp_test(
    name = "reproducible_paths_test",
    srcs = ["ReproduciblePathsTest.cs"],
    data = [":lib"],
    deps = ["//tests/support:runfiles"],
)

# A binary cross-compiled for Linux ARM64 is an ELF apphost.
linux_binary_collector(
    name = "linux_arm64_app",
    binary = ":app",
)

csharp_test(
    name = "linux_elf_test",
    srcs = ["LinuxElfTest.cs"],
    data = [":linux_arm64_app"],
    deps = ["//tests/support:runfiles"],
)

# Task 6: Csproj and BUILD synchronization round-trip test
csharp_test(
    name = "sync_roundtrip_test",
    srcs = ["SyncRoundtripTest.cs"],
    data = ["//csharp:sync"],
    deps = ["//tests/support:runfiles"],
)

# NuGet packages resolve from an offline mirror.
csharp_test(
    name = "offline_mirror_test",
    srcs = ["OfflineMirrorTest.cs"],
)

# Task 11: Enterprise Integration Tests
csharp_test(
    name = "web_test",
    srcs = ["WebTest.cs"],
    sdk = "Microsoft.NET.Sdk.Web",
)

# A real MSTest suite run through vstest, with the adapter from the MSTest.TestAdapter package.
csharp_test(
    name = "mstest_suite",
    srcs = ["MSTestSuite.cs"],
    target_type = "library",
    test_filter = "TestCategory=Unit",
    deps = [
        "@nuget//:MSTest.TestAdapter",
        "@nuget//:MSTest.TestFramework",
        "@nuget//:Microsoft.NET.Test.Sdk",
    ],
)

# Three shards for two tests, so one shard runs nothing and still passes.
csharp_test(
    name = "mstest_sharded",
    srcs = ["MSTestSuite.cs"],
    shard_count = 3,
    target_type = "library",
    test_filter = "TestCategory=Unit",
    deps = [
        "@nuget//:MSTest.TestAdapter",
        "@nuget//:MSTest.TestFramework",
        "@nuget//:Microsoft.NET.Test.Sdk",
    ],
)
