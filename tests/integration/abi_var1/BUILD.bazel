load("//csharp:defs.bzl", "csharp_library")

package(default_visibility = ["//visibility:public"])

csharp_library(
    name = "lib",
    srcs = ["Lib.cs"],
)

csharp_library(
    name = "ivt_lib",
    srcs = ["IvtLib.cs"],
    internals_visible_to = [
        "Friend",
        "ivtfriendtest",
    ],
)

# Compiles only if a friend gets the reference assembly with internals.
csharp_library(
    name = "Friend",
    srcs = ["Friend.cs"],
    deps = [":ivt_lib"],
)
