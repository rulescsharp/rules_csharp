load("//csharp:defs.bzl", "csharp_binary", "csharp_grpc_library", "csharp_import", "csharp_library", "csharp_proto_library", "csharp_test")
load(
    ":action_graph_tests.bzl",
    "abi_refout_action_test",
    "analyzes_test",
    "compilation_mode_action_test",
    "cross_linux_action_test",
    "cross_windows_action_test",
    "csc_worker_action_test",
    "editorconfig_action_test",
    "expect_failure_test",
    "framework_reference_action_test",
    "hermetic_sandbox_action_test",
    "msbuild_parity_action_test",
    "older_csharp_info",
    "older_csharp_info_dep_test",
    "opt_compilation_mode_action_test",
    "output_assembly_action_test",
    "proto_moved_test",
    "target_framework_action_test",
    "web_sdk_action_test",
    "worker_sdk_action_test",
)

package(default_visibility = ["//visibility:public"])

csharp_library(
    name = "lib_a",
    srcs = ["LibA.cs"],
)

csharp_library(
    name = "lib_b",
    srcs = ["LibB.cs"],
    deps = [":lib_a"],
)

csharp_library(
    name = "net8_lib",
    srcs = ["LibA.cs"],
    target_framework = "net8.0",
)

csharp_library(
    name = "web_lib",
    srcs = ["LibA.cs"],
    sdk = "Microsoft.NET.Sdk.Web",
)

csharp_library(
    name = "aspnetcore_lib",
    srcs = ["LibA.cs"],
    framework_references = ["Microsoft.AspNetCore.App"],
)

# Depends on the ASP.NET Core shared framework only through :aspnetcore_lib.
csharp_binary(
    name = "aspnetcore_dependent_app",
    srcs = ["CrossApp.cs"],
    deps = [":aspnetcore_lib"],
)

csharp_library(
    name = "worker_lib",
    srcs = ["LibA.cs"],
    framework_references = ["Microsoft.AspNetCore.App"],
    sdk = "Microsoft.NET.Sdk.Worker",
)

csharp_library(
    name = "worker_without_hosting_lib",
    srcs = ["LibA.cs"],
    sdk = "Microsoft.NET.Sdk.Worker",
    tags = ["manual"],
)

csharp_library(
    name = "unknown_framework_lib",
    srcs = ["LibA.cs"],
    framework_references = ["Microsoft.WindowsDesktop.App"],
    tags = ["manual"],
)

csharp_library(
    name = "renamed_lib",
    srcs = ["LibA.cs"],
    output_assembly = "Contoso.Greeting",
)

csharp_binary(
    name = "renamed_app",
    srcs = ["CrossApp.cs"],
    output_assembly = "Contoso.App",
    deps = [":renamed_lib"],
)

# Two libraries in one package may share an assembly name, but one app can't load both.
csharp_library(
    name = "shared_name_a",
    srcs = ["LibA.cs"],
    output_assembly = "Shared",
)

csharp_library(
    name = "shared_name_b",
    srcs = ["LibB.cs"],
    output_assembly = "Shared",
    deps = [":lib_a"],
)

csharp_binary(
    name = "shared_name_app",
    srcs = ["CrossApp.cs"],
    tags = ["manual"],
    deps = [
        ":shared_name_a",
        ":shared_name_b",
    ],
)

csharp_binary(
    name = "cross_app",
    srcs = ["CrossApp.cs"],
)

# A dep that returns CSharpInfo without the fields added after 0.4.0 still works.
older_csharp_info(
    name = "older_info",
    lib = ":lib_a",
)

csharp_library(
    name = "on_older_info",
    srcs = ["LibB.cs"],
    deps = [":older_info"],
)

older_csharp_info_dep_test(
    name = "older_csharp_info_dep_test",
    target_under_test = ":on_older_info",
)

csharp_import(
    name = "import_on_older_info",
    deps = [":older_info"],
)

older_csharp_info_dep_test(
    name = "older_csharp_info_import_dep_test",
    target_under_test = ":import_on_older_info",
)

# The proto rules moved to rules_csharp_proto. Old call sites keep their attributes and fail
# with the migration steps.
csharp_proto_library(
    name = "moved_cs_proto",
    proto = ":unused_proto",
    tags = ["manual"],
)

csharp_grpc_library(
    name = "moved_cs_grpc",
    proto = ":unused_proto",
    tags = ["manual"],
)

abi_refout_action_test(
    name = "abi_refout_action_test",
    target_under_test = ":lib_b",
)

cross_windows_action_test(
    name = "cross_windows_action_test",
    target_under_test = ":cross_app",
)

cross_linux_action_test(
    name = "cross_linux_action_test",
    target_under_test = ":cross_app",
)

csc_worker_action_test(
    name = "csc_worker_action_test",
    target_under_test = ":lib_a",
)

web_sdk_action_test(
    name = "web_sdk_action_test",
    target_under_test = ":web_lib",
)

editorconfig_action_test(
    name = "editorconfig_action_test",
    target_under_test = "//tests/integration/editorconfig:editorconfig_lib",
)

framework_reference_action_test(
    name = "framework_reference_action_test",
    target_under_test = ":aspnetcore_dependent_app",
)

worker_sdk_action_test(
    name = "worker_sdk_action_test",
    target_under_test = ":worker_lib",
)

expect_failure_test(
    name = "worker_without_hosting_test",
    message = "whose implicit usings need the Microsoft.Extensions",
    target_under_test = ":worker_without_hosting_lib",
)

expect_failure_test(
    name = "unknown_framework_test",
    message = "is not a shared framework the toolchain provides",
    target_under_test = ":unknown_framework_lib",
)

output_assembly_action_test(
    name = "output_assembly_action_test",
    target_under_test = ":renamed_app",
)

expect_failure_test(
    name = "duplicate_assembly_test",
    message = "loads two assemblies named Shared, from",
    target_under_test = ":shared_name_app",
)

# Two test platform packages both ship Microsoft.TestPlatform.CoreUtilities.dll. The app keeps the
# first one in dependency order.
csharp_binary(
    name = "package_copies_app",
    srcs = ["CrossApp.cs"],
    deps = ["@nuget//:Microsoft.NET.Test.Sdk"],
)

analyzes_test(
    name = "package_copies_test",
    target_under_test = ":package_copies_app",
)

# A library built here that takes the name of a package's dll still fails.
csharp_library(
    name = "package_name_lib",
    srcs = ["LibA.cs"],
    output_assembly = "Microsoft.TestPlatform.CoreUtilities",
)

csharp_binary(
    name = "package_name_app",
    srcs = ["CrossApp.cs"],
    tags = ["manual"],
    deps = [
        ":package_name_lib",
        "@nuget//:Microsoft.NET.Test.Sdk",
    ],
)

expect_failure_test(
    name = "package_name_clash_test",
    message = "tests/analysis:package_name_lib so each name is unique.",
    target_under_test = ":package_name_app",
)

# One library built for two frameworks is still one assembly, so the app loads it fine.
csharp_library(
    name = "two_framework_lib",
    srcs = ["LibB.cs"],
    target_framework = "net8.0",
    deps = [":lib_a"],
)

csharp_binary(
    name = "two_framework_app",
    srcs = ["CrossApp.cs"],
    deps = [
        ":lib_a",
        ":two_framework_lib",
    ],
)

analyzes_test(
    name = "same_library_two_frameworks_test",
    target_under_test = ":two_framework_app",
)

msbuild_parity_action_test(
    name = "msbuild_parity_action_test",
    target_under_test = ":lib_a",
)

proto_moved_test(
    name = "proto_moved_test",
    rule_name = "csharp_proto_library",
    target_under_test = ":moved_cs_proto",
)

proto_moved_test(
    name = "grpc_moved_test",
    rule_name = "csharp_grpc_library",
    target_under_test = ":moved_cs_grpc",
)

hermetic_sandbox_action_test(
    name = "hermetic_sandbox_action_test",
    target_under_test = ":lib_a",
)

csharp_library(
    name = "unsafe_lib",
    srcs = ["LibA.cs"],
    allow_unsafe_blocks = True,
)

compilation_mode_action_test(
    name = "debug_compilation_mode_action_test",
    expected_flags = [
        "-define:DEBUG;TRACE",
        "-unsafe+",
    ],
    target_under_test = ":unsafe_lib",
    unexpected_flags = ["-optimize+"],
)

opt_compilation_mode_action_test(
    name = "opt_compilation_mode_action_test",
    expected_flags = [
        "-define:TRACE",
        "-optimize+",
    ],
    target_under_test = ":lib_a",
    unexpected_flags = [
        "-define:DEBUG;TRACE",
        "-unsafe+",
    ],
)

target_framework_action_test(
    name = "net8_target_framework_action_test",
    expected_tfm = "net8.0",
    target_under_test = ":net8_lib",
)

target_framework_action_test(
    name = "default_target_framework_action_test",
    expected_tfm = "net10.0",
    target_under_test = ":lib_a",
)


# The docs match the Stardoc output and avoid filler wording.
csharp_test(
    name = "docs_test",
    srcs = ["//tests/support:DocsTest.cs"],
    data = [
        "//:README.md",
        "//csharp:bzl_srcs",
        "//docs",
        "//docs:defs.md",
    ],
    env = {
        "DOCS_GENERATED": "docs/defs_generated.md",
        "DOCS_REFERENCE": "docs/defs.md",
        "DOCS_SCAN": "README.md",
    },
    deps = ["//tests/support:runfiles"],
)
