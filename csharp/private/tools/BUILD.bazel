load("//csharp:defs.bzl", "csharp_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*"]))

csharp_library(
    name = "apphost_patcher",
    srcs = ["AppHostPatcher.cs"],
    target_type = "exe",
    visibility = ["//visibility:public"],
)

# A plain file, so building any binary needs no shell action. binary.bzl passes it to
# dotnet exec with --runtimeconfig, since it doesn't sit next to the patcher dll.
alias(
    name = "apphost_patcher_runtimeconfig",
    actual = "apphost_patcher.runtimeconfig.json",
    visibility = ["//visibility:public"],
)

csharp_library(
    name = "vstest_launcher",
    srcs = ["VstestLauncher.cs"],
    target_type = "exe",
    visibility = ["//visibility:public"],
)
