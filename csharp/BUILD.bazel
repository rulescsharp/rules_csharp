load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//csharp:defs.bzl", "csharp_binary")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.bzl"]))

filegroup(
    name = "bzl_srcs",
    srcs = glob(["*.bzl"]) + ["//csharp/private:bzl_srcs"],
    visibility = ["//visibility:public"],
)

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

csharp_binary(
    name = "sync",
    srcs = ["//csharp/private/tools:CsprojSync.cs"],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "proto_bzl",
    srcs = ["proto.bzl"],
    deps = [
        "//csharp/private:common_bzl",
        "//csharp/private:compile_bzl",
        "@protobuf//bazel/common:proto_info_bzl",
    ],
)

bzl_library(
    name = "defs_bzl",
    srcs = ["defs.bzl"],
    deps = [
        ":proto_bzl",
        "//csharp/private:binary_bzl",
        "//csharp/private:compile_bzl",
        "//csharp/private:providers_bzl",
    ],
)

bzl_library(
    name = "toolchains_bzl",
    srcs = ["toolchains.bzl"],
    deps = [
        "//csharp/private:toolchain_impl_bzl",
        "@bazel_tools//tools/build_defs/repo:utils.bzl",
    ],
)

bzl_library(
    name = "extensions_bzl",
    srcs = ["extensions.bzl"],
    deps = [
        ":toolchains_bzl",
        "//csharp/private:nuget_repo_bzl",
        "@bazel_tools//tools:bzl_srcs",
    ],
)
