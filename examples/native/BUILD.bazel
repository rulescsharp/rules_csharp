load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")
load("@rules_csharp//csharp:defs.bzl", "csharp_binary")

cc_library(
    name = "add_impl",
    srcs = ["add.c"],
)

# The file name has to be one DllImport("add") probes for on each OS.
cc_shared_library(
    name = "add",
    shared_lib_name = select({
        "@platforms//os:macos": "libadd.dylib",
        "@platforms//os:windows": "add.dll",
        "//conditions:default": "libadd.so",
    }),
    deps = [":add_impl"],
)

# native_libs puts the shared library next to the app's dll, where DllImport looks.
csharp_binary(
    name = "native",
    srcs = ["Native.cs"],
    native_libs = [":add"],
)
