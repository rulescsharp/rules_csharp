load("@rules_csharp//csharp:defs.bzl", "csharp_binary", "csharp_library", "csharp_test")

package(default_visibility = ["//visibility:public"])

csharp_library(
    name = "greeter",
    srcs = ["Greeter.cs"],
    generate_documentation_file = True,
    target_framework = "net8.0",
)

csharp_binary(
    name = "hello",
    srcs = ["Hello.cs"],
    deps = [":greeter"],
)

csharp_test(
    name = "greeter_test",
    srcs = ["GreeterTest.cs"],
    target_framework = "net8.0",
    deps = [":greeter"],
)

# An MSTest suite run by vstest. Bazel splits its test cases across two
# shards, and each shard's test.xml lists the cases it ran.
csharp_test(
    name = "greeter_mstest",
    srcs = ["GreeterMSTest.cs"],
    shard_count = 2,
    target_framework = "net8.0",
    target_type = "library",
    deps = [
        ":greeter",
        "@nuget//:MSTest.TestAdapter",
        "@nuget//:MSTest.TestFramework",
        "@nuget//:Microsoft.NET.Test.Sdk",
    ],
)

# Passes -checked+ through additional_compiler_options (MSBuild AdditionalOptions).
csharp_binary(
    name = "checked_add",
    srcs = ["Checked.cs"],
    additional_compiler_options = ["-checked+"],
)

# A csharp_binary runs as a build tool. This one generates a source file for show_version,
# with no installed .NET needed.
csharp_binary(
    name = "make_version",
    srcs = ["MakeVersion.cs"],
)

genrule(
    name = "build_info",
    outs = ["BuildInfo.g.cs"],
    cmd = "$(execpath :make_version) 1.2.3 $@",
    tools = [":make_version"],
)

csharp_binary(
    name = "show_version",
    srcs = [
        "ShowVersion.cs",
        ":build_info",
    ],
)
