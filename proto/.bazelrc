common --enable_bzlmod
build --incompatible_strict_action_env
test --test_output=errors

# Build against the rules_csharp in this checkout instead of the registry release.
common --override_module=rules_csharp=..

# protoc builds from source. MSVC defaults to C++14 and protobuf needs C++17.
common --enable_platform_specific_config
build:windows --cxxopt=/std:c++17 --host_cxxopt=/std:c++17
