common --enable_bzlmod
build --incompatible_strict_action_env
test --test_output=errors

# Build against the rules_csharp in this checkout instead of the registry release.
common --override_module=rules_csharp=..

# Fall back to a Maven Central mirror for stardoc's jars. See ../bazel_downloader.cfg.
common --experimental_downloader_config=../bazel_downloader.cfg

# Use protobuf's prebuilt protoc instead of building it from source.
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc
common --incompatible_enable_proto_toolchain_resolution
