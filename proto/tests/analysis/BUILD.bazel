load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_csharp//csharp:defs.bzl", "csharp_test")
load("//csharp:defs.bzl", "csharp_proto_library")
load(":action_graph_tests.bzl", "proto_action_test")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "greeter_proto",
    srcs = ["greeter.proto"],
)

csharp_proto_library(
    name = "greeter_cs_proto",
    proto = ":greeter_proto",
    tags = ["manual"],
)

proto_action_test(
    name = "proto_action_test",
    target_under_test = ":greeter_cs_proto",
)

csharp_test(
    name = "docs_test",
    srcs = ["@rules_csharp//tests/support:DocsTest.cs"],
    data = [
        "//:README.md",
        "//csharp:bzl_srcs",
        "//docs",
    ],
    env = {
        "DOCS_GENERATED": "docs/README.md",
        "DOCS_REFERENCE": "README.md",
    },
    deps = ["@rules_csharp//tests/support:runfiles"],
)
